# =============================================================
# Configuracion del servicio ASIX Speech-to-Text
# Copia este fichero a ".env" y ajusta los valores:
#     cp .env.example .env
# =============================================================

# --- Servidor HTTP -----------------------------------------------------
STT_HOST=127.0.0.1
STT_PORT=5000
STT_DEBUG=true

# --- Gemini ------------------------------------------------------------
# Consigue la clave gratuita en https://aistudio.google.com/apikey
# Si la dejas vacia, el endpoint cae automaticamente al proveedor "mock".
GEMINI_API_KEY=

# gemini-3.8-flash        -> multimodal, acepta audio
# gemini-3.5-transcribe   -> modelo dedicado a transcripcion (mas rapido)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=60

# Si True y Gemini falla, se responde con el proveedor simulado en lugar
# de devolver un error. Ponlo a False en produccion.
STT_ALLOW_MOCK_FALLBACK=true

# --- Validacion de audio ----------------------------------------------
STT_MAX_UPLOAD_MB=25
STT_DEFAULT_LANG=es-ES
